// ZZP Schakel — Prisma schema
// Communicatieplatform: identiteit, zzp-profielen, bedrijven, directe
// berichten, notificaties, eigen facturen, beheer/moderatie en contact.
// De vroegere opdrachten-/matching-/review-/betalingsmodellen zijn verwijderd
// (migratie 00000000000012_verwijder_opdrachten). Zie docs/DATABASE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Directe verbinding voor migraties (Supabase pooler ondersteunt geen DDL).
  // Valt terug op DATABASE_URL wanneer DIRECT_URL niet is gezet.
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ZZP
  COMPANY
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
}

enum UserStatus {
  ACTIEF
  GEBLOKKEERD
  VERWIJDERD
}

enum TokenType {
  EMAIL_VERIFICATIE
  MAGIC_LINK
  WACHTWOORD_RESET
}

// ── Modellen ─────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String? // null wanneer alleen magic link wordt gebruikt
  role            UserRole
  adminRole       AdminRole? // alleen gezet wanneer role = ADMIN
  status          UserStatus @default(ACTIEF)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  sessions               Session[]
  tokens                 VerificationToken[]
  zzpProfile             ZZPProfile?
  documents              Document[]
  bestanden              StoredFile[]
  companyMemberships     CompanyMember[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  sentMessages           Message[]
  reportsIngediend       Report[]
  auditLogs              AuditLog[]
  oauthAccounts          OAuthAccount[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete t.b.v. AVG/audit

  @@index([role])
  @@index([status])
}

// Gekoppelde externe logins (Google, Apple). Eén account kan meerdere
// providers hebben; een provider-account hoort bij precies één gebruiker.
model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "apple"
  providerAccountId String // stabiele "sub" van de provider
  email             String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Hash van het sessietoken; het ruwe token staat alleen in de cookie.
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

// ── FASE 2: ZZP-profiel, catalogus en profielonderdelen ──────────────────────

enum VerificatieStatus {
  NIET_GEVERIFIEERD
  IN_BEHANDELING
  GEVERIFIEERD
  AFGEKEURD
}

enum BeschikbaarheidType {
  FULLTIME
  PARTTIME
  INCIDENTEEL
}

enum DocumentType {
  IDENTITEIT
  VCA
  CERTIFICAAT
  VERZEKERING
  KVK
  OVERIG
}

model ZZPProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Persoonlijk / bedrijf
  voornaam           String?
  achternaam         String?
  telefoon           String?
  bedrijfsnaam       String?
  kvkNummer          String?
  // Gevuld na een geslaagde controle in het KvK Handelsregister.
  kvkNaam            String?
  kvkGecontroleerdOp DateTime?

  // Factuurgegevens (voor de ingebouwde facturenmodule)
  btwId    String?
  iban     String?
  adres    String?
  postcode String?
  plaats   String?

  // Profiel
  over           String?
  jarenErvaring  Int?
  uurtariefCents Int?
  // Profielfoto (sleutel in de bestandsopslag; publiek, vierkant, WebP).
  fotoKey        String?

  // "Anders, namelijk…": vrije tekst naast de keuzelijsten.
  vakgebiedAnders     String?
  specialisatieAnders String?
  certificatenAnders  String?

  // Werkgebied (geocoding volgt later; nu plaats + straal)
  werkgebiedPlaats String?
  werkgebiedLat    Float?
  werkgebiedLng    Float?
  maxReisafstandKm Int?

  // Materieel
  eigenBus         Boolean @default(false)
  eigenGereedschap Boolean @default(false)
  vca              Boolean @default(false)

  startdatum DateTime?

  profielCompleetheidPct Int               @default(0)
  verificatieStatus      VerificatieStatus @default(NIET_GEVERIFIEERD)
  zichtbaar              Boolean           @default(false)

  skills          ZZPSkill[]
  specializations ZZPSpecialization[]
  certifications  ZZPCertification[]
  availability    Availability[]
  portfolio       PortfolioItem[]
  conversations   Conversation[]
  zzpInvoices     ZzpInvoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([verificatieStatus])
  @@index([zichtbaar])
  @@index([werkgebiedLat, werkgebiedLng])
}

model Skill {
  id              String           @id @default(uuid())
  naam            String           @unique
  slug            String           @unique
  actief          Boolean          @default(true)
  specializations Specialization[]
  zzpSkills       ZZPSkill[]
}

model Specialization {
  id      String  @id @default(uuid())
  skillId String
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  naam    String
  slug    String
  actief  Boolean @default(true)

  zzpSpecializations ZZPSpecialization[]

  @@unique([skillId, slug])
}

model Certification {
  id     String  @id @default(uuid())
  naam   String  @unique
  slug   String  @unique
  actief Boolean @default(true)

  zzpCertifications ZZPCertification[]
}

model ZZPSkill {
  zzpProfileId String
  zzpProfile   ZZPProfile @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([zzpProfileId, skillId])
  @@index([skillId])
}

model ZZPSpecialization {
  zzpProfileId     String
  zzpProfile       ZZPProfile     @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([zzpProfileId, specializationId])
  @@index([specializationId])
}

model ZZPCertification {
  id              String            @id @default(uuid())
  zzpProfileId    String
  zzpProfile      ZZPProfile        @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  certificationId String
  certification   Certification     @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  geldigTot       DateTime?
  documentId      String?
  status          VerificatieStatus @default(NIET_GEVERIFIEERD)

  @@unique([zzpProfileId, certificationId])
}

model Availability {
  id           String              @id @default(uuid())
  zzpProfileId String
  zzpProfile   ZZPProfile          @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  van          DateTime
  tot          DateTime?
  type         BeschikbaarheidType @default(FULLTIME)
  createdAt    DateTime            @default(now())

  @@index([zzpProfileId, van])
}

model Document {
  id           String            @id @default(uuid())
  ownerUserId  String
  owner        User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  type         DocumentType
  bestandsnaam String
  opslagKey    String
  mime         String
  grootte      Int
  status       VerificatieStatus @default(NIET_GEVERIFIEERD)
  createdAt    DateTime          @default(now())

  @@index([ownerUserId])
}

// Bestandsopslag in de database (profiel- en portfoliofoto's, documenten).
// Publieke bestanden (key begint met "public/") worden zonder handtekening
// uitgeserveerd via /api/bestanden; privébestanden alleen via een kort geldige
// gesigneerde URL. Bestanden gaan mee weg met de eigenaar (AVG).
model StoredFile {
  id          String   @id @default(uuid())
  key         String   @unique
  mime        String
  grootte     Int
  data        Bytes
  publiek     Boolean  @default(false)
  ownerUserId String?
  owner       User?    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([ownerUserId])
}

model PortfolioItem {
  id            String     @id @default(uuid())
  zzpProfileId  String
  zzpProfile    ZZPProfile @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  titel         String
  omschrijving  String?
  afbeeldingKey String?
  volgorde      Int        @default(0)
  createdAt     DateTime   @default(now())

  @@index([zzpProfileId])
}

// ── FASE 3: Bedrijven ────────────────────────────────────────────────────────

enum CompanyMemberRole {
  OWNER
  LID
}

model Company {
  id                 String            @id @default(uuid())
  naam               String
  kvkNummer          String?
  // Gevuld na een geslaagde controle in het KvK Handelsregister.
  kvkNaam            String?
  kvkGecontroleerdOp DateTime?
  omschrijving       String?
  website            String?
  telefoon           String?
  contactpersoon     String?
  regio              String?
  typeWerkzaamheden  String?
  verificatieStatus  VerificatieStatus @default(NIET_GEVERIFIEERD)

  // Factuurgegevens (voor de facturenmodule)
  btwId    String?
  iban     String?
  adres    String?
  postcode String?
  plaats   String?

  members       CompanyMember[]
  conversations Conversation[]
  eigenFacturen ZzpInvoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([verificatieStatus])
}

model CompanyMember {
  id        String            @id @default(uuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CompanyMemberRole @default(OWNER)
  createdAt DateTime          @default(now())

  @@unique([companyId, userId])
  @@index([userId])
}

// ── FASE 5: Interactie (berichten, notificaties) ─────────────────────────────

enum NotificationType {
  NIEUW_BERICHT
  VERIFICATIE_AFGEROND
}

model Conversation {
  id           String     @id @default(uuid())
  // Direct contact tussen één bedrijf en één zzp'er; hooguit één gesprek per paar.
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  zzpProfileId String
  zzpProfile   ZZPProfile @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  messages     Message[]

  createdAt      DateTime @default(now())
  laatsteBericht DateTime @default(now())

  @@unique([companyId, zzpProfileId])
  @@index([companyId])
  @@index([zzpProfileId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  sender         User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  body           String
  gelezenOp      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  titel     String
  tekst     String
  link      String?
  gelezenOp DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, gelezenOp])
}

model NotificationPreference {
  userId         String  @id
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailBerichten Boolean @default(true)
}

// ── FASE 7: Admin, moderatie en audit ────────────────────────────────────────

enum ReportStatus {
  OPEN
  IN_BEHANDELING
  AFGEHANDELD
  AFGEWEZEN
}

enum ReportSubjectType {
  USER
  COMPANY
  ZZP_PROFIEL
  MESSAGE
}

enum ComplaintStatus {
  OPEN
  IN_BEHANDELING
  AFGEHANDELD
}

model Report {
  id            String            @id @default(uuid())
  melderUserId  String?
  melder        User?             @relation(fields: [melderUserId], references: [id], onDelete: SetNull)
  subjectType   ReportSubjectType
  subjectId     String
  reden         String
  toelichting   String?
  status        ReportStatus      @default(OPEN)
  createdAt     DateTime          @default(now())
  afgehandeldOp DateTime?

  @@index([status])
}

model Complaint {
  id        String          @id @default(uuid())
  naam      String
  email     String
  onderwerp String
  bericht   String
  status    ComplaintStatus @default(OPEN)
  createdAt DateTime        @default(now())

  @@index([status])
}

// Append-only audit trail voor beveiligings- en beheergevoelige acties.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actie       String
  subjectType String?
  subjectId   String?
  meta        Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
}

// Logboek van vragen aan de AI-assistent, zodat we zien wat bezoekers vragen.
// Geen relatie naar User: ook anonieme (uitgelogde) bezoekers stellen vragen.
model AssistantLog {
  id              String   @id @default(uuid())
  vraag           String
  antwoord        String
  aantalBerichten Int      @default(1)
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

enum ZzpInvoiceStatus {
  CONCEPT
  VERSTUURD
  GEOPEND
  BETAALD
  TE_LAAT
  GEANNULEERD
}

// Factuur die een zzp'er of bedrijf zelf in de app opmaakt (in ZZP Schakel-huisstijl).
// Afzender- en klantgegevens worden als momentopname opgeslagen, zodat een
// factuur juridisch onveranderd blijft als het profiel later wijzigt.
model ZzpInvoice {
  id           String      @id @default(uuid())
  // Eigenaar is óf een zzp'er óf een bedrijf (precies één is gezet).
  zzpProfileId String?
  zzpProfile   ZZPProfile? @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  factuurnummer      String
  status             ZzpInvoiceStatus @default(CONCEPT)
  factuurdatum       DateTime
  vervaldatum        DateTime?
  betaaltermijnDagen Int?
  betaalreferentie   String?
  btwVerlegd         Boolean          @default(false)

  // Afzender (momentopname)
  afzenderNaam     String
  afzenderAdres    String?
  afzenderPostcode String?
  afzenderPlaats   String?
  afzenderKvk      String?
  afzenderBtwId    String?
  afzenderIban     String?
  afzenderEmail    String?
  afzenderTelefoon String?
  afzenderWebsite  String?

  // Klant
  klantNaam           String
  klantContactpersoon String?
  klantAdres          String?
  klantPostcode       String?
  klantPlaats         String?
  klantEmail          String?
  klantKvk            String?
  klantBtwId          String?

  btwPercentage  Int     @default(21)
  subtotaalCents Int     @default(0)
  btwCents       Int     @default(0)
  totaalCents    Int     @default(0)
  opmerking      String?

  lines     ZzpInvoiceLine[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([zzpProfileId])
  @@index([companyId])
  @@index([createdAt])
}

model ZzpInvoiceLine {
  id            String     @id @default(uuid())
  invoiceId     String
  invoice       ZzpInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  omschrijving  String
  aantal        Float      @default(1)
  eenheid       String?
  tariefCents   Int        @default(0)
  btwPercentage Int        @default(21)
  bedragCents   Int        @default(0)
  volgorde      Int        @default(0)

  @@index([invoiceId])
}

// ── Contactformulier ───────────────────────────────────────────────────────
enum ContactStatus {
  NIEUW
  BEANTWOORD
  GESLOTEN
}

model ContactMessage {
  id        String        @id @default(uuid())
  naam      String
  email     String
  onderwerp String
  bericht   String
  status    ContactStatus @default(NIEUW)
  ip        String?
  createdAt DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
}

// ── Analytics: first-party, privacyvriendelijke event tracking ──────────────
// Eén platte eventtabel; `metadata` is vrij zodat nieuwe events geen
// schemawijziging vragen. Geen ruwe user-agent, geen IP, referrer alleen als
// hostnaam. Geen foreign key naar User: events blijven pseudoniem bruikbaar
// na verwijdering van een account (userId wordt dan op null gezet).
model AnalyticsEvent {
  id          String    @id @default(uuid())
  eventName   String
  userId      String?
  userRole    UserRole?
  anonymousId String?
  sessionId   String?
  page        String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  deviceType  String?
  browser     String?
  os          String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([eventName, createdAt])
  @@index([sessionId])
  @@index([anonymousId])
  @@index([userId])
  @@map("analytics_events")
}
