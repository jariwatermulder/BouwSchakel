// ZZP Connect — Prisma schema
// FASE 1 (Foundation): identiteit, rollen, sessies en verificatietokens.
// Latere fasen voegen ZZPProfile, Company, Job, Match, Application, Assignment,
// Conversation, Message, Review, Verification, Notification, etc. toe.
// Zie docs/DATABASE.md voor het volledige beoogde datamodel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Directe verbinding voor migraties (Supabase pooler ondersteunt geen DDL).
  // Valt terug op DATABASE_URL wanneer DIRECT_URL niet is gezet.
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ZZP
  COMPANY
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
}

enum UserStatus {
  ACTIEF
  GEBLOKKEERD
  VERWIJDERD
}

enum TokenType {
  EMAIL_VERIFICATIE
  MAGIC_LINK
  WACHTWOORD_RESET
}

// ── Modellen ─────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String? // null wanneer alleen magic link wordt gebruikt
  role            UserRole
  adminRole       AdminRole? // alleen gezet wanneer role = ADMIN
  status          UserStatus @default(ACTIEF)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  sessions               Session[]
  tokens                 VerificationToken[]
  zzpProfile             ZZPProfile?
  documents              Document[]
  companyMemberships     CompanyMember[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  sentMessages           Message[]
  reviews                Review[]
  reportsIngediend       Report[]
  auditLogs              AuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete t.b.v. AVG/audit

  @@index([role])
  @@index([status])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Hash van het sessietoken; het ruwe token staat alleen in de cookie.
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

// ── FASE 2: ZZP-profiel, catalogus en profielonderdelen ──────────────────────

enum VerificatieStatus {
  NIET_GEVERIFIEERD
  IN_BEHANDELING
  GEVERIFIEERD
  AFGEKEURD
}

enum BeschikbaarheidType {
  FULLTIME
  PARTTIME
  INCIDENTEEL
}

enum DocumentType {
  IDENTITEIT
  VCA
  CERTIFICAAT
  VERZEKERING
  KVK
  OVERIG
}

model ZZPProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Persoonlijk / bedrijf
  voornaam     String?
  achternaam   String?
  telefoon     String?
  bedrijfsnaam String?
  kvkNummer    String?

  // Factuurgegevens (voor de ingebouwde facturenmodule)
  btwId    String?
  iban     String?
  adres    String?
  postcode String?
  plaats   String?

  // Profiel
  over           String?
  jarenErvaring  Int?
  uurtariefCents Int?

  // Werkgebied (geocoding volgt later; nu plaats + straal)
  werkgebiedPlaats String?
  werkgebiedLat    Float?
  werkgebiedLng    Float?
  maxReisafstandKm Int?

  // Materieel
  eigenBus         Boolean @default(false)
  eigenGereedschap Boolean @default(false)
  vca              Boolean @default(false)

  startdatum DateTime?

  profielCompleetheidPct Int               @default(0)
  verificatieStatus      VerificatieStatus @default(NIET_GEVERIFIEERD)
  zichtbaar              Boolean           @default(false)

  skills          ZZPSkill[]
  specializations ZZPSpecialization[]
  certifications  ZZPCertification[]
  availability    Availability[]
  portfolio       PortfolioItem[]
  matches         Match[]
  applications    Application[]
  assignments     Assignment[]
  conversations   Conversation[]
  zzpInvoices     ZzpInvoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([verificatieStatus])
  @@index([zichtbaar])
  @@index([werkgebiedLat, werkgebiedLng])
}

model Skill {
  id              String           @id @default(uuid())
  naam            String           @unique
  slug            String           @unique
  actief          Boolean          @default(true)
  specializations Specialization[]
  zzpSkills       ZZPSkill[]
  jobs            Job[]
}

model Specialization {
  id      String  @id @default(uuid())
  skillId String
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  naam    String
  slug    String
  actief  Boolean @default(true)

  zzpSpecializations ZZPSpecialization[]
  jobs               Job[]

  @@unique([skillId, slug])
}

model Certification {
  id     String  @id @default(uuid())
  naam   String  @unique
  slug   String  @unique
  actief Boolean @default(true)

  zzpCertifications ZZPCertification[]
  jobRequirements   JobRequirement[]
}

model ZZPSkill {
  zzpProfileId String
  zzpProfile   ZZPProfile @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([zzpProfileId, skillId])
  @@index([skillId])
}

model ZZPSpecialization {
  zzpProfileId     String
  zzpProfile       ZZPProfile     @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([zzpProfileId, specializationId])
  @@index([specializationId])
}

model ZZPCertification {
  id              String            @id @default(uuid())
  zzpProfileId    String
  zzpProfile      ZZPProfile        @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  certificationId String
  certification   Certification     @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  geldigTot       DateTime?
  documentId      String?
  status          VerificatieStatus @default(NIET_GEVERIFIEERD)

  @@unique([zzpProfileId, certificationId])
}

model Availability {
  id           String              @id @default(uuid())
  zzpProfileId String
  zzpProfile   ZZPProfile          @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  van          DateTime
  tot          DateTime?
  type         BeschikbaarheidType @default(FULLTIME)
  createdAt    DateTime            @default(now())

  @@index([zzpProfileId, van])
}

model Document {
  id           String            @id @default(uuid())
  ownerUserId  String
  owner        User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  type         DocumentType
  bestandsnaam String
  opslagKey    String
  mime         String
  grootte      Int
  status       VerificatieStatus @default(NIET_GEVERIFIEERD)
  createdAt    DateTime          @default(now())

  @@index([ownerUserId])
}

model PortfolioItem {
  id            String     @id @default(uuid())
  zzpProfileId  String
  zzpProfile    ZZPProfile @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  titel         String
  omschrijving  String?
  afbeeldingKey String?
  volgorde      Int        @default(0)
  createdAt     DateTime   @default(now())

  @@index([zzpProfileId])
}

// ── FASE 3: Bedrijven en opdrachten ──────────────────────────────────────────

enum CompanyMemberRole {
  OWNER
  LID
}

enum JobStatus {
  CONCEPT
  GEPUBLICEERD
  GESLOTEN
  VERVULD
  VERLOPEN
  GEANNULEERD
}

model Company {
  id                String            @id @default(uuid())
  naam              String
  kvkNummer         String?
  omschrijving      String?
  website           String?
  telefoon          String?
  contactpersoon    String?
  regio             String?
  typeWerkzaamheden String?
  verificatieStatus VerificatieStatus @default(NIET_GEVERIFIEERD)

  members       CompanyMember[]
  jobs          Job[]
  assignments   Assignment[]
  conversations Conversation[]
  invoices      Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([verificatieStatus])
}

model CompanyMember {
  id        String            @id @default(uuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CompanyMemberRole @default(OWNER)
  createdAt DateTime          @default(now())

  @@unique([companyId, userId])
  @@index([userId])
}

model Job {
  id               String          @id @default(uuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill           @relation(fields: [skillId], references: [id])
  specializationId String?
  specialization   Specialization? @relation(fields: [specializationId], references: [id])

  titel        String
  slug         String @unique
  omschrijving String

  locatiePlaats String
  locatieAdres  String?
  lat           Float?
  lng           Float?

  startdatum              DateTime
  einddatum               DateTime?
  duurDagen               Int?
  aantalPersonen          Int       @default(1)
  gewenstUurtariefCents   Int?
  eigenGereedschapGewenst Boolean   @default(false)

  contactpersoon      String?
  status              JobStatus @default(CONCEPT)
  publiekIndexeerbaar Boolean   @default(true)

  requirements  JobRequirement[]
  matches       Match[]
  applications  Application[]
  assignments   Assignment[]
  conversations Conversation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([skillId, status])
  @@index([status, startdatum])
  @@index([companyId])
  @@index([lat, lng])
}

model JobRequirement {
  id              String         @id @default(uuid())
  jobId           String
  job             Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  certificationId String?
  certification   Certification? @relation(fields: [certificationId], references: [id])
  vrijeTekst      String?
  hard            Boolean        @default(false)

  @@index([jobId])
}

// ── FASE 4: Matching ─────────────────────────────────────────────────────────

// Berekende match ZZP<->opdracht. Kan gecachet/herberekend worden; in de MVP
// wordt de score veelal live berekend. subscores bevat de uitleg per dimensie.
model Match {
  id           String     @id @default(uuid())
  jobId        String
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  zzpProfileId String
  zzpProfile   ZZPProfile @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  score        Int
  subscores    Json
  geschikt     Boolean    @default(true)
  berekendOp   DateTime   @default(now())

  @@unique([jobId, zzpProfileId])
  @@index([jobId, score])
  @@index([zzpProfileId])
}

// Configureerbare gewichten en drempels voor de matching engine (admin, FASE 7).
// Eén rij met id "default". Gewichten sommeren tot 100.
model MatchingSetting {
  id                     String   @id @default("default")
  gewichtVakgebied       Int      @default(25)
  gewichtBeschikbaarheid Int      @default(20)
  gewichtSpecialisatie   Int      @default(15)
  gewichtLocatie         Int      @default(15)
  gewichtTarief          Int      @default(10)
  gewichtErvaring        Int      @default(5)
  gewichtCertificaten    Int      @default(5)
  gewichtBetrouwbaarheid Int      @default(5)
  minMatchScore          Int      @default(50)
  maxAfstandKm           Int      @default(150)
  updatedAt              DateTime @updatedAt
}

// ── FASE 5: Interactie (reacties, opdrachten, berichten, notificaties) ───────

enum ApplicationStatus {
  NIEUW
  BEKEKEN
  UITGENODIGD
  AFGEWEZEN
  GEACCEPTEERD
  INGETROKKEN
}

enum ApplicationRichting {
  SOLLICITATIE // ZZP'er reageert op opdracht
  UITNODIGING // bedrijf nodigt ZZP'er uit
}

enum AssignmentStatus {
  GEPLAND
  ACTIEF
  AFGEROND
  GEANNULEERD
  GESCHIL
}

enum NotificationType {
  NIEUWE_MATCH
  NIEUWE_REACTIE
  UITNODIGING
  GESELECTEERD
  AFGEWEZEN
  NIEUW_BERICHT
  OPDRACHT_GEWIJZIGD
  REVIEW_ONTVANGEN
  VERIFICATIE_AFGEROND
}

model Application {
  id                     String              @id @default(uuid())
  jobId                  String
  job                    Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  zzpProfileId           String
  zzpProfile             ZZPProfile          @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  status                 ApplicationStatus   @default(NIEUW)
  richting               ApplicationRichting
  bericht                String?
  uurtariefVoorstelCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, zzpProfileId])
  @@index([jobId, status])
  @@index([zzpProfileId])
}

model Assignment {
  id           String           @id @default(uuid())
  jobId        String
  job          Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  zzpProfileId String
  zzpProfile   ZZPProfile       @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status       AssignmentStatus @default(GEPLAND)
  startdatum   DateTime
  einddatum    DateTime?
  gewerkteUren Int?

  reviews     Review[]
  invoice     Invoice?
  zzpInvoices ZzpInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([zzpProfileId])
  @@index([jobId])
}

model Conversation {
  id           String     @id @default(uuid())
  jobId        String
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  zzpProfileId String
  zzpProfile   ZZPProfile @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  messages     Message[]

  createdAt      DateTime @default(now())
  laatsteBericht DateTime @default(now())

  @@unique([jobId, companyId, zzpProfileId])
  @@index([companyId])
  @@index([zzpProfileId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  sender         User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  body           String
  gelezenOp      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  titel     String
  tekst     String
  link      String?
  gelezenOp DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, gelezenOp])
}

model NotificationPreference {
  userId         String  @id
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailReacties  Boolean @default(true)
  emailBerichten Boolean @default(true)
  emailMatches   Boolean @default(true)
  emailReviews   Boolean @default(true)
}

// ── FASE 6: Reviews & reputatie ──────────────────────────────────────────────

enum ReviewDirection {
  ZZP_NAAR_BEDRIJF
  BEDRIJF_NAAR_ZZP
}

// Review na een afgeronde opdracht. Alleen mogelijk bij een bestaande
// Assignment; onveranderbaar na publicatie (behalve via moderatie).
// De subject-velden zijn gedenormaliseerd voor snelle reputatie-aggregatie.
// Zie docs/MATCHING.md (betrouwbaarheid).
model Review {
  id           String          @id @default(uuid())
  assignmentId String
  assignment   Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  richting     ReviewDirection
  auteurUserId String
  auteur       User            @relation(fields: [auteurUserId], references: [id], onDelete: Cascade)

  overZzpProfileId String?
  overCompanyId    String?

  scoreKwaliteit       Int
  scoreCommunicatie    Int
  scoreBetrouwbaarheid Int
  scoreAfspraken       Int
  toelichting          String?

  gepubliceerdOp DateTime @default(now())

  @@unique([assignmentId, richting])
  @@index([overZzpProfileId])
  @@index([overCompanyId])
}

// ── FASE 7: Admin, moderatie en audit ────────────────────────────────────────

enum ReportStatus {
  OPEN
  IN_BEHANDELING
  AFGEHANDELD
  AFGEWEZEN
}

enum ReportSubjectType {
  USER
  COMPANY
  ZZP_PROFIEL
  JOB
  REVIEW
  MESSAGE
}

enum ComplaintStatus {
  OPEN
  IN_BEHANDELING
  AFGEHANDELD
}

model Report {
  id            String            @id @default(uuid())
  melderUserId  String?
  melder        User?             @relation(fields: [melderUserId], references: [id], onDelete: SetNull)
  subjectType   ReportSubjectType
  subjectId     String
  reden         String
  toelichting   String?
  status        ReportStatus      @default(OPEN)
  createdAt     DateTime          @default(now())
  afgehandeldOp DateTime?

  @@index([status])
}

model Complaint {
  id        String          @id @default(uuid())
  naam      String
  email     String
  onderwerp String
  bericht   String
  status    ComplaintStatus @default(OPEN)
  createdAt DateTime        @default(now())

  @@index([status])
}

// Append-only audit trail voor beveiligings- en beheergevoelige acties.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actie       String
  subjectType String?
  subjectId   String?
  meta        Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
}

// ── FASE 8: Betalingen (fees, facturen, betalingen) ──────────────────────────

enum FeeModel {
  PER_UUR
  VAST
}

enum InvoiceStatus {
  CONCEPT
  OPEN
  BETAALD
  MISLUKT
  GECREDITEERD
}

enum PaymentStatus {
  IN_AFWACHTING
  GESLAAGD
  MISLUKT
  GEREFUND
}

// Eén rij ("default"). Alle bedragen configureerbaar via admin — nooit hardcoded.
model PricingSetting {
  id                        String   @id @default("default")
  feeModel                  FeeModel @default(PER_UUR)
  succesfeePerUurCents      Int      @default(750)
  vasteBemiddelingsfeeCents Int      @default(0)
  proMaandCents             Int      @default(19900)
  btwPercentage             Int      @default(21)
  updatedAt                 DateTime @updatedAt
}

model Invoice {
  id             String        @id @default(uuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignmentId   String?       @unique
  assignment     Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  omschrijving   String
  subtotaalCents Int
  btwCents       Int
  bedragCents    Int
  status         InvoiceStatus @default(OPEN)
  payments       Payment[]
  uitgegevenOp   DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId])
  @@index([status])
}

model Payment {
  id          String        @id @default(uuid())
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  provider    String
  providerRef String?
  bedragCents Int
  status      PaymentStatus @default(IN_AFWACHTING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([invoiceId])
}

// Logboek van vragen aan de AI-assistent, zodat we zien wat bezoekers vragen.
// Geen relatie naar User: ook anonieme (uitgelogde) bezoekers stellen vragen.
model AssistantLog {
  id              String   @id @default(uuid())
  vraag           String
  antwoord        String
  aantalBerichten Int      @default(1)
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

enum ZzpInvoiceStatus {
  CONCEPT
  VERSTUURD
  BETAALD
}

// Factuur die een zzp'er zelf in de app opmaakt (in ZZP Connect-huisstijl).
// Afzender- en klantgegevens worden als momentopname opgeslagen, zodat een
// factuur juridisch onveranderd blijft als het profiel later wijzigt.
model ZzpInvoice {
  id           String      @id @default(uuid())
  zzpProfileId String
  zzpProfile   ZZPProfile  @relation(fields: [zzpProfileId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  factuurnummer String
  status        ZzpInvoiceStatus @default(CONCEPT)
  factuurdatum  DateTime
  vervaldatum   DateTime?

  // Afzender (momentopname)
  afzenderNaam     String
  afzenderAdres    String?
  afzenderPostcode String?
  afzenderPlaats   String?
  afzenderKvk      String?
  afzenderBtwId    String?
  afzenderIban     String?
  afzenderEmail    String?

  // Klant
  klantNaam     String
  klantAdres    String?
  klantPostcode String?
  klantPlaats   String?
  klantEmail    String?
  klantKvk      String?

  btwPercentage  Int    @default(21)
  subtotaalCents Int    @default(0)
  btwCents       Int    @default(0)
  totaalCents    Int    @default(0)
  opmerking      String?

  lines     ZzpInvoiceLine[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([zzpProfileId, factuurnummer])
  @@index([zzpProfileId])
  @@index([createdAt])
}

model ZzpInvoiceLine {
  id          String     @id @default(uuid())
  invoiceId   String
  invoice     ZzpInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  omschrijving String
  aantal      Float      @default(1)
  tariefCents Int        @default(0)
  bedragCents Int        @default(0)
  volgorde    Int        @default(0)

  @@index([invoiceId])
}
