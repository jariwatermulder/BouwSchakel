# ZZP Schakel — voorbeeld-omgevingsvariabelen.
# Kopieer naar .env en vul in. Commit NOOIT echte secrets.

# ── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
# Zie docs/DATABASE_SETUP.md voor het ophalen van het wachtwoord.
# App/runtime = pooler (6543); migraties = directe verbinding (5432).
DATABASE_URL="postgresql://postgres.pzpegcnvtzamsjqboyxz:[WACHTWOORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[WACHTWOORD]@db.pzpegcnvtzamsjqboyxz.supabase.co:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Sterke, willekeurige waarde van minimaal 32 tekens.
# Genereer bijv. met: openssl rand -base64 48
AUTH_SECRET="vervang-dit-door-een-lange-willekeurige-waarde"

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ── E-mail (Resend) ───────────────────────────────────────────────────────────
# Zonder deze waarden werkt de app gewoon, maar worden er geen mails verstuurd.
# Zie docs/EMAIL_SETUP.md. API-sleutel: https://resend.com → API Keys.
# EMAIL_FROM: een adres op een in Resend geverifieerd domein, bijv.
# "ZZP Schakel <no-reply@zzpschakel.nl>". Zonder eigen domein kun je testen met
# "onboarding@resend.dev" (stuurt alleen naar je eigen Resend-account-adres).
RESEND_API_KEY=""
EMAIL_FROM="ZZP Schakel <onboarding@resend.dev>"

# ── Inloggen met Google en Apple (optioneel) ─────────────────────────────────
# Zonder deze waarden worden de knoppen niet getoond. Zie docs/OAUTH.md voor
# het aanmaken van de sleutels en de redirect-URI's.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Apple: Services ID als client id, plus Team ID, Key ID en de inhoud van het
# .p8-bestand (regeleinden mogen als \n).
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# ── AI-assistent (Anthropic / Claude) ────────────────────────────────────────
# Zonder ANTHROPIC_API_KEY werkt de site gewoon; de chat-assistent verwijst dan
# vriendelijk naar de contactpagina. Sleutel: https://console.anthropic.com → API Keys.
# ANTHROPIC_MODEL is optioneel. Voor een publieke widget is een sneller/goedkoper
# model aan te raden, bijv. "claude-haiku-4-5" (standaard: "claude-opus-5").
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-haiku-4-5"
# Optioneel: ontvang elke gestelde vraag ook per e-mail (naast opslag in de DB).
# ASSISTANT_NOTIFY_EMAIL="jij@voorbeeld.nl"

# ── Bestandsopslag ────────────────────────────────────────────────────────────
# Profiel-/portfoliofoto's en documenten staan in de database (tabel
# StoredFile); er is geen aparte opslagprovider nodig.
# MOLLIE_API_KEY=""

# ── KvK-controle (optioneel) ─────────────────────────────────────────────────
# Sleutel voor de KvK Zoeken API (https://developers.kvk.nl). Zonder sleutel
# controleert de site alleen het formaat (8 cijfers). Zie docs/KVK.md.
KVK_API_KEY=
# Alleen voor de KvK-testomgeving; leeg = productie (https://api.kvk.nl/api/v2/zoeken).
KVK_API_URL=

# ── Contact & bedrijfsgegevens (juridische pagina's, contactpagina) ──────────
# Beheer-inbox voor het contactformulier (optioneel).
CONTACT_EMAIL=
# Officiële gegevens van de aanbieder. Zolang deze leeg zijn, toont de site op
# de juridische pagina's een "nog aan te vullen"-melding. Nooit verzinnen.
NEXT_PUBLIC_BEDRIJF_NAAM=
NEXT_PUBLIC_BEDRIJF_ADRES=
NEXT_PUBLIC_BEDRIJF_KVK=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_TELEFOON=
