# BouwSchakel — voorbeeld-omgevingsvariabelen.
# Kopieer naar .env en vul in. Commit NOOIT echte secrets.

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Host wordt later definitief gekozen (Supabase / Vercel Postgres / Neon / anders).
# Prisma blijft de ORM. Voorbeeld lokaal:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bouwschakel?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Sterke, willekeurige waarde van minimaal 32 tekens.
# Genereer bijv. met: openssl rand -base64 48
AUTH_SECRET="vervang-dit-door-een-lange-willekeurige-waarde"

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ── Later toe te voegen providers (nog niet vereist) ──────────────────────────
# E-mail (transactioneel), object storage, geocoding, payments (Mollie/Stripe).
# RESEND_API_KEY=""
# STORAGE_BUCKET=""
# GEOCODING_API_KEY=""
# MOLLIE_API_KEY=""
