# BouwSchakel — voorbeeld-omgevingsvariabelen.
# Kopieer naar .env en vul in. Commit NOOIT echte secrets.

# ── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
# Zie docs/DATABASE_SETUP.md voor het ophalen van het wachtwoord.
# App/runtime = pooler (6543); migraties = directe verbinding (5432).
DATABASE_URL="postgresql://postgres.pzpegcnvtzamsjqboyxz:[WACHTWOORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[WACHTWOORD]@db.pzpegcnvtzamsjqboyxz.supabase.co:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Sterke, willekeurige waarde van minimaal 32 tekens.
# Genereer bijv. met: openssl rand -base64 48
AUTH_SECRET="vervang-dit-door-een-lange-willekeurige-waarde"

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ── E-mail (Resend) ───────────────────────────────────────────────────────────
# Zonder deze waarden werkt de app gewoon, maar worden er geen mails verstuurd.
# Zie docs/EMAIL_SETUP.md. API-sleutel: https://resend.com → API Keys.
# EMAIL_FROM: een adres op een in Resend geverifieerd domein, bijv.
# "BouwSchakel <no-reply@bouwschakel.nl>". Zonder eigen domein kun je testen met
# "onboarding@resend.dev" (stuurt alleen naar je eigen Resend-account-adres).
RESEND_API_KEY=""
EMAIL_FROM="BouwSchakel <onboarding@resend.dev>"

# ── Later toe te voegen providers (nog niet vereist) ──────────────────────────
# Object storage, geocoding, payments (Mollie/Stripe).
# STORAGE_BUCKET=""
# GEOCODING_API_KEY=""
# MOLLIE_API_KEY=""
